<button
  id="theme-toggle"
  type="button"
  aria-label="切换深浅色"
  title="切换深浅色"
  class="nav-toggle flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-surface-alt"
>
  <!-- 浅色模式下显示「切到深色」的月亮；深色模式下显示太阳。纯 CSS 切换，无需 JS -->
  <svg
    class="block h-4 w-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg
    class="hidden h-4 w-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.remove('dark', 'light');
    root.classList.add(next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* 隐私模式下 localStorage 可能不可用，忽略 */
    }
  });
</script>
