---
/**
 * 回到顶部按钮 —— 滚出首屏后才出现。
 *
 * 用 scroll + rAF 节流判断（而不是 IntersectionObserver）：只需要比较
 * scrollY 与视口高度，比挂观察器更直接，成本可忽略。
 * 尊重 prefers-reduced-motion：开启后不做平滑滚动。
 */
---

<a href="#" id="back-to-top" class="back-to-top" aria-label="回到顶部">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 19V5"></path>
    <path d="M5 12l7-7 7 7"></path>
  </svg>
</a>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 0.5px solid var(--header-line);
    color: var(--ink-muted);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .back-to-top:hover {
    color: var(--ink);
  }

  .back-to-top svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  @media (min-width: 640px) {
    .back-to-top {
      right: 1.75rem;
      bottom: 1.75rem;
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>

<script data-astro-rerun>
  // data-astro-rerun：导航后重新执行（新页面要重新判断可见性）。
  // __backToTopBound 守卫保证 window / document 级监听只绑一次，不随导航累积。
  (() => {
    if (window.__backToTopBound) return;
    window.__backToTopBound = true;

    let ticking = false;

    const update = () => {
      const button = document.getElementById('back-to-top');
      if (button) {
        button.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
      }
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    // 站内导航后是新页面，重新判断一次
    document.addEventListener('astro:page-load', update);

    // 事件委托：导航换了按钮也不必重新绑定
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('#back-to-top')) return;

      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });

    update();
  })();
</script>
