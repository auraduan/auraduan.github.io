---
interface Props {
  title: string;
  description?: string;
  /** 标题上方的小字，用于分类/标签名 */
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mx-auto max-w-[980px] px-6 pb-12 pt-20 md:pt-24">
  {eyebrow && <p class="mb-3 text-caption uppercase tracking-widest text-ink-muted">{eyebrow}</p>}
  <h1 class="text-h1 text-ink">{title}</h1>
  {description && <p class="mt-4 max-w-[52ch] text-body text-ink-muted">{description}</p>}
</header>
