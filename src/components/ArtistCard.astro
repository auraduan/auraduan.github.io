---
import { Image } from 'astro:assets';
import type { ArtistEntry } from '../lib/content';

interface Props {
  artist: ArtistEntry;
}

const { artist } = Astro.props;
const { name, profile, albums, rating } = artist;
const avatar = profile?.data.avatar;
---

<a href={`/artists/${artist.id}`} class="artist-card group block focus-visible:outline-none">
  <div class="artist-lift relative aspect-square w-full overflow-hidden rounded-card-sm">
    {
      avatar ? (
        <Image
          src={avatar}
          alt={`${name} 的头像`}
          widths={[300, 600]}
          sizes="(max-width: 640px) 45vw, 220px"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        /* 没写档案的歌手也照常出现，只是卡片朴素一些——一张占位块，一枚名字首字 */
        <div
          class="flex h-full w-full items-center justify-center border border-line"
          style="background-color: var(--surface-alt);"
          aria-hidden="true"
        >
          <span class="text-h2" style="color: var(--ink); opacity: 0.32;">
            {name.slice(0, 1)}
          </span>
        </div>
      )
    }
  </div>

  <div class="mt-2.5">
    <p class="truncate text-small text-ink">{name}</p>
    <p class="mt-0.5 flex items-baseline gap-1.5 truncate text-caption text-ink-muted">
      {
        rating !== undefined && (
          <>
            <span class="tabular-nums" style="color: var(--accent);">
              {rating.toFixed(1)}
            </span>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <span>{albums.length} 张专辑</span>
    </p>
  </div>
</a>

<style>
  /* 与专辑卡同一套手感：上浮，封面轻微推近。这里不翻面——歌手卡背面没有内容可看 */
  .artist-lift {
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .artist-card:hover .artist-lift,
  .artist-card:focus-visible .artist-lift {
    transform: translateY(-4px);
  }

  .artist-lift :global(img) {
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .artist-card:hover .artist-lift :global(img),
  .artist-card:focus-visible .artist-lift :global(img) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .artist-card:hover .artist-lift,
    .artist-card:focus-visible .artist-lift,
    .artist-card:hover .artist-lift :global(img),
    .artist-card:focus-visible .artist-lift :global(img) {
      transform: none !important;
    }
  }
</style>
