---
import { SOCIAL, SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-line">
  <div
    class="mx-auto flex max-w-[980px] flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="space-y-1">
      <p class="text-small text-ink">{SITE.title}</p>
      <p class="text-caption text-ink-muted">
        © {year} {SITE.author} · 内容转载请注明出处
      </p>
    </div>

    <ul class="flex flex-wrap items-center gap-5">
      {
        SOCIAL.filter((item) => item.href).map((item) => {
          const external = item.href.startsWith('http');
          return (
            <li>
              <a
                href={item.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="tap-area inline-block text-caption text-ink-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
