---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../site.config';

interface Props {
  /** 页面标题（不含站点名，会自动拼接） */
  title?: string;
  description?: string;
  /** 社交分享图，绝对路径或完整 URL */
  image?: string;
  /** 宽版布局：不加顶部导航留白，供首页全屏首屏使用 */
  wide?: boolean;
  /** 首屏是整屏壁纸：页眉初始透明，滚动后恢复常规样式 */
  overHero?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  wide = false,
  overHero = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      视图过渡：站内跳转时做一次淡入淡出，而不是白屏硬切。
      Astro 原生能力，零额外依赖；默认动画即为克制的 fade，符合 §6.9。
      过渡结束后新页面会重新执行脚本，所以主题初始化与滚动监听都会自然重绑。
    */}
    <ClientRouter />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" id="favicon-link" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    {/*
      主题初始化必须内联在 <head> 中、早于渲染执行，否则刷新会闪白。
      见 docs/需求方案.md §9 坑位 4。
      Expressive Code 的代码主题由 .light / .dark 类驱动，两个类都要打。
    */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          let theme;

          if (stored === 'dark' || stored === 'light') {
            // 用户手动选过 —— 以他的选择为准，永不被覆盖
            theme = stored;
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            // 系统是深色就用深色；系统是浅色时，按时间自动切（入夜转深色）
            theme = prefersDark || new Date().getHours() < 6 || new Date().getHours() >= 19
              ? 'dark'
              : 'light';
          }

          document.documentElement.classList.add(theme);

          // favicon 跟随主题：SVG 内部的 prefers-color-scheme 只认系统偏好，
          // 认不了站内由 class 驱动的切换，所以这里显式替换一次。
          const icon = document.getElementById('favicon-link');
          if (icon) {
            icon.setAttribute('href', theme === 'dark' ? '/favicon-dark.svg' : '/favicon.svg');
          }
        } catch (e) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    <!-- JS 不可用时的兜底：入场动效的初始隐藏态必须被撤销，否则内容不可见 -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    {/*
      页面级附加样式插槽。目前用于按需引入 KaTeX——
      它必须在 <head> 里（渲染阻塞资源），放在 body 会导致首屏先用无样式
      状态绘制，此时公式的 MathML 与 HTML 两套输出会同时可见。
    */}
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-small"
    >
      跳到正文
    </a>

    <Nav overHero={overHero} />

    <main id="main" class={wide ? 'flex-1' : 'flex-1 pt-12'}>
      <slot />
    </main>

    <Footer />

    <!-- 回到顶部：滚出首屏后浮现 -->
    <BackToTop />

    <!-- 命令面板（站内搜索）：入口在页眉按钮与 Ctrl/⌘+K -->
    <SearchPalette />
  </body>
</html>

<script data-astro-rerun>
  // 滚动入场动效：只播一次，回滚不重播（需求方案 §6.8）
  //
  // ⚠ 视图过渡下脚本会随每次导航重新执行。observer 复用同一个（挂在 window 上），
  //   但每次都必须把「新页面里还没 revealed 的元素」重新纳入观察 ——
  //   否则这些元素会永远停在 opacity: 0，表现为「点导航后内容一片空白，刷新才出现」。
  (() => {
    const pending = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
    if (pending.length === 0) return;

    if (!('IntersectionObserver' in window)) {
      // 不支持时直接呈现终态，不留白屏
      pending.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    // ⚠ 带 data-astro-rerun 的脚本会被 Astro 内联输出、**不经过 esbuild 转译**，
    //   所以这里不能写 TS 语法（`as unknown as` 会原样进浏览器 → 语法错误 → 整块脚本废掉）。
    //   用 JSDoc 断言，TS 与原生 JS 下都合法。
    const scope = /** @type {any} */ (window);

    if (!scope.__revealObserver) {
      scope.__revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              scope.__revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
    }

    pending.forEach((el) => scope.__revealObserver.observe(el));
  })();
</script>

<style is:global>
  /* 入场动效基态。全局的 prefers-reduced-motion 规则会把时长压到 0.01ms，
     因此开启「减少动效」时元素直接呈现终态，不会留下不可见的内容。
     必须用 is:global —— 这些元素散落在各个子页面里。 */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
</style>
