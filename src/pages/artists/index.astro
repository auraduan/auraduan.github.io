---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArtistCard from '../../components/ArtistCard.astro';
import { collectArtists } from '../../lib/content';

/**
 * 歌手墙。
 *
 * 列表**不是**手写的清单——由专辑的 artist 字段自动汇总（lib/content.ts → collectArtists）。
 * 于是「加一张专辑，歌手页自动更新」，不用维护两处。
 * 有档案的歌手显示头像与评分，没有的显示占位块 + 作品数。
 */
const artists = await collectArtists();
---

<BaseLayout title="歌手" description="按人看我听过的音乐">
  <PageHeader
    title="歌手"
    description="把听过的唱片按人摊开。写了几位喜欢的：头像、评分与一段介绍；没写的也会自动出现在这里。"
  />

  <div class="mx-auto max-w-[980px] px-6 pb-24">
    {
      artists.length > 0 ? (
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
          {artists.map((artist) => (
            <ArtistCard artist={artist} />
          ))}
        </div>
      ) : (
        <p class="text-small text-ink-muted">
          还没有歌手。专辑入库后，这里的歌手会自动汇总出来。
        </p>
      )
    }
  </div>
</BaseLayout>
