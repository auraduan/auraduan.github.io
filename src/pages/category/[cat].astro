---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { collectCategories, getPublishedPosts, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return collectCategories(posts).map(({ category }) => ({
    params: { cat: category },
    props: { category, posts: posts.filter((post) => post.data.category === category) },
  }));
}

interface Props {
  category: string;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`} description={`分类「${category}」下的全部文章`}>
  <PageHeader eyebrow="分类" title={category} description={`共 ${posts.length} 篇。`} />

  <div class="mx-auto max-w-[980px] px-6 pb-24">
    <div class="grid gap-10 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
