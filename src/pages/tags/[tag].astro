---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { collectTags, getPublishedPosts, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`}>
  <PageHeader eyebrow="标签" title={tag} description={`共 ${posts.length} 篇。`} />

  <div class="mx-auto max-w-[980px] px-6 pb-24">
    <div class="grid gap-10 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <div class="mt-16">
      <a href="/tags" class="tap-area inline-block text-small text-accent hover:underline"
        >← 全部标签</a
      >
    </div>
  </div>
</BaseLayout>
