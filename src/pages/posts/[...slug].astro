---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import katexStyles from 'katex/dist/katex.min.css?url';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import FootnoteTooltip from '../../components/FootnoteTooltip.astro';
import {
  adjacentPosts,
  formatDate,
  formatDateCN,
  getPublishedPosts,
  readingTime,
  relatedPosts,
  resolveAspect,
  type Post,
} from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data, body } = post;

const { Content, headings } = await render(post);

const all = await getPublishedPosts();
const related = relatedPosts(post, all);

// 相邻文章：按时间轴取前后各一篇。prev = 更早的一篇，next = 更新的一篇
const { prev, next } = adjacentPosts(post, all);

// 目录只收二、三级标题。
// 排除 GFM 脚注区自动生成的 "Footnotes" 标题 —— 它是给屏幕阅读器用的，
// 不该出现在目录里，否则每篇带脚注的文章都会多一项。
const isFootnoteHeading = (slug: string) =>
  slug === 'footnote-label' || slug.startsWith('user-content-fn');

const toc = data.toc
  ? headings.filter((h) => (h.depth === 2 || h.depth === 3) && !isFootnoteHeading(h.slug))
  : [];

/**
 * 封面与标题并排。
 *
 * 桌面端：标题文字在左、封面在右（300px 固定宽），整块左对齐到正文栏，
 *        所以标题、封面、正文、目录共用同一条左基准线。
 * 移动端：封面落到标题下方，避免进页面先看到一张大图、标题被压到屏幕外。
 *
 * 注意整页**不再使用 mx-auto 居中单栏**——之前标题区居中、正文左对齐，
 * 两者差 126px 缩进，视觉上是错位的。
 */
const aspect = resolveAspect(data.coverAspect, data.cover);

// 封面同时用作社交分享图，分享出去的卡片才有图
const ogImage = data.cover
  ? (await getImage({ src: data.cover, width: 1200, format: 'jpeg', quality: 82 })).src
  : undefined;
---

<BaseLayout title={data.title} description={data.description} image={ogImage} wide>
  <!--
    KaTeX 样式必须进 <head>：它是渲染阻塞资源。原来放在 body 里，首屏会先以
    无样式状态绘制——此时 KaTeX 的 MathML 与 HTML 两套输出同时可见，
    看起来就是「公式重叠、乱成一团」。仅在 math: true 的文章里加载。
  -->
  {data.math && <link slot="head" rel="stylesheet" href={katexStyles} />}

  <ReadingProgress />
  <FootnoteTooltip />

  <article class="mx-auto max-w-[980px] px-6 pb-16 pt-20 md:pt-24">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
      <div class="min-w-0 flex-1" style="max-width: 680px;">
        <p class="text-caption uppercase tracking-widest text-ink-muted">
          <a href={`/category/${data.category}`} class="tap-area transition-colors hover:text-ink">
            {data.category}
          </a>
        </p>
        <h1 class="mt-3 text-h1 text-ink">{data.title}</h1>
        <p class="mt-4 text-body text-ink-muted">{data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-caption text-ink-muted">
          <time datetime={data.publishedAt.toISOString()}>
            {formatDateCN(data.publishedAt)}
          </time>
          {
            data.updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span>更新于 {formatDate(data.updatedAt)}</span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>约 {readingTime(body)} 分钟</span>

          <!-- 分享：优先系统原生分享（移动端最好用），不支持则降级为复制链接 -->
          <button
            type="button"
            id="share-post"
            data-share-title={data.title}
            class="tap-area ml-1 inline-flex items-center gap-1 text-caption text-ink-muted transition-colors hover:text-ink"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M12 3v12"></path>
              <path d="M7.5 7.5 12 3l4.5 4.5"></path>
              <path d="M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path>
            </svg>
            <span data-share-label>分享</span>
          </button>
        </div>

        {
          data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tags/${tag}`}
                    class="inline-block rounded-pill px-3 py-1.5 text-caption text-ink-muted transition-colors hover:text-ink"
                    style="background-color: var(--surface-alt);"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        data.cover && (
          <figure
            class="w-full shrink-0 overflow-hidden rounded-card sm:w-[300px]"
            style={`aspect-ratio: ${aspect};`}
          >
            <Image
              src={data.cover}
              alt={`${data.title} 封面`}
              widths={[300, 600]}
              sizes="(max-width: 640px) 100vw, 300px"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )
      }
    </header>

    <!-- 无封面时用一条分隔线代替封面的分隔作用 -->
    {!data.cover && <hr class="mt-12 max-w-[680px] border-line" />}

    <div class="mt-14 flex gap-12">
      <div class="prose-article min-w-0 flex-1" style="max-width: 680px;">
        <Content />
      </div>

      {
        toc.length > 0 && (
          <aside class="hidden w-[200px] shrink-0 lg:block">
            <div class="sticky top-20">
              <Toc headings={toc} />
            </div>
          </aside>
        )
      }
    </div>

    <!--
      相邻文章：接着读的入口，紧贴正文。语义按时间轴——「上一篇」= 更早、「下一篇」= 更新，
      两栏都带日期，避免歧义。构建时算好，零运行时成本。
    -->
    {
      (prev || next) && (
        <nav class="mt-16 max-w-[680px] border-t border-line pt-8" aria-label="相邻文章">
          <div class="grid gap-6 sm:grid-cols-2">
            {prev && (
              <a href={`/posts/${prev.id}`} class="group block">
                <span class="block text-caption text-ink-muted">← 上一篇</span>
                <span class="mt-1 block text-body text-ink transition-colors group-hover:text-accent">
                  {prev.data.title}
                </span>
                <span class="mt-1 block text-caption tabular-nums text-ink-muted">
                  {formatDate(prev.data.publishedAt)}
                </span>
              </a>
            )}
            {next && (
              <a
                href={`/posts/${next.id}`}
                class:list={['group block sm:text-right', !prev && 'sm:col-start-2']}
              >
                <span class="block text-caption text-ink-muted">下一篇 →</span>
                <span class="mt-1 block text-body text-ink transition-colors group-hover:text-accent">
                  {next.data.title}
                </span>
                <span class="mt-1 block text-caption tabular-nums text-ink-muted">
                  {formatDate(next.data.publishedAt)}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-24 max-w-[680px] border-t border-line pt-12">
          <h2 class="text-h3 text-ink">相关文章</h2>
          <ul class="mt-6 space-y-6">
            {related.map((item) => (
              <li>
                <a href={`/posts/${item.id}`} class="group block">
                  <span class="block text-body text-ink transition-colors group-hover:text-accent">
                    {item.data.title}
                  </span>
                  <span class="mt-1 block text-caption text-ink-muted">
                    {formatDate(item.data.publishedAt)} · {item.data.category}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-16 max-w-[680px]">
      <a href="/posts" class="tap-area inline-block text-small text-accent hover:underline"
        >← 返回文章列表</a
      >
    </div>
  </article>
</BaseLayout>

<script data-astro-rerun>
  /**
   * 分享按钮 —— 优先用系统原生分享（移动端体验最好）；
   * 不支持时降级为复制链接。桌面 Firefox 等没有 navigator.share，
   * 所以降级分支不是可选项，是必需的。
   */
  (() => {
    const scope = /** @type {any} */ (window);
    if (scope.__shareBound) return;
    scope.__shareBound = true;

    let resetTimer;

    document.addEventListener('click', async (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest('#share-post') : null;
      if (!button) return;

      const title = button.getAttribute('data-share-title') ?? document.title;
      const url = location.href;
      const label = button.querySelector('[data-share-label]');
      const original = label ? label.textContent : '';

      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch (e) {
          /* 用户取消分享，静默 */
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = '已复制';
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            label.textContent = original;
          }, 1600);
        }
      } catch (e) {
        /* 剪贴板不可用（非 HTTPS 或权限被拒），静默 */
      }
    });
  })();
</script>
