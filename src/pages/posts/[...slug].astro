---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import katexStyles from 'katex/dist/katex.min.css?url';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import FootnoteTooltip from '../../components/FootnoteTooltip.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import CollectionChapters from '../../components/CollectionChapters.astro';
import {
  adjacentPosts,
  collectCollections,
  formatDate,
  formatDateCN,
  getPostAlbums,
  getPublishedPosts,
  readingTime,
  relatedPosts,
  resolveAspect,
  collectionPosition,
  type Post,
} from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data, body } = post;

const { Content, headings } = await render(post);

const all = await getPublishedPosts();
const related = relatedPosts(post, all);

// 相邻文章：按时间轴取前后各一篇。prev = 更早的一篇，next = 更新的一篇
const { prev, next } = adjacentPosts(post, all);

// 关联专辑：frontmatter 填了 album 才有出口。可以是一张，也可以是一组
// （如一首单曲 + 它后来被收录的专辑）；对不上的 id 会被跳过（只 warn）
const postAlbums = await getPostAlbums(post);

// 所属合集与它在其中的位置。不属于任何合集时是 undefined，整块不渲染
const collectionInfo = collectionPosition(post, await collectCollections());

// 目录只收二、三级标题。
// 排除 GFM 脚注区自动生成的 "Footnotes" 标题 —— 它是给屏幕阅读器用的，
// 不该出现在目录里，否则每篇带脚注的文章都会多一项。
const isFootnoteHeading = (slug: string) =>
  slug === 'footnote-label' || slug.startsWith('user-content-fn');

const toc = data.toc
  ? headings.filter((h) => (h.depth === 2 || h.depth === 3) && !isFootnoteHeading(h.slug))
  : [];

/**
 * 封面与标题并排。
 *
 * 桌面端：标题文字在左、封面在右（300px 固定宽），整块左对齐到正文栏，
 *        所以标题、封面、正文、目录共用同一条左基准线。
 * 移动端：封面落到标题下方，避免进页面先看到一张大图、标题被压到屏幕外。
 *
 * 注意整页**不再使用 mx-auto 居中单栏**——之前标题区居中、正文左对齐，
 * 两者差 126px 缩进，视觉上是错位的。
 */
const aspect = resolveAspect(data.coverAspect, data.cover);

// 封面同时用作社交分享图，分享出去的卡片才有图。
// 尺寸一并取出来交给 BaseLayout —— 有了 og:image:width/height，
// 平台在图片下载完之前就能预留正确的版面比例，不会先抖一下。
const ogImageData = data.cover
  ? await getImage({ src: data.cover, width: 1200, format: 'jpeg', quality: 82 })
  : undefined;
const ogImage = ogImageData?.src;
const ogImageWidth = ogImageData?.attributes.width;
const ogImageHeight = ogImageData?.attributes.height;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={ogImage}
  imageAlt={data.cover ? `${data.title} 封面` : undefined}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  type="article"
  wide
>
  <!--
    KaTeX 样式必须进 <head>：它是渲染阻塞资源。原来放在 body 里，首屏会先以
    无样式状态绘制——此时 KaTeX 的 MathML 与 HTML 两套输出同时可见，
    看起来就是「公式重叠、乱成一团」。仅在 math: true 的文章里加载。
  -->
  <Fragment slot="head">
    {data.math && <link rel="stylesheet" href={katexStyles} />}
    <!-- 文章的 Open Graph 细节：分享卡片上的日期、作者与栏目 -->
    <meta property="article:published_time" content={data.publishedAt.toISOString()} />
    {data.updatedAt && (
      <meta property="article:modified_time" content={data.updatedAt.toISOString()} />
    )}
    <meta property="article:section" content={data.category} />
    {data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <ReadingProgress />
  <FootnoteTooltip />

  <article class="mx-auto max-w-[980px] px-6 pb-16 pt-20 md:pt-24">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
      <div class="min-w-0 flex-1" style="max-width: 680px;">
        <p class="text-caption uppercase tracking-widest text-ink-muted">
          <a href={`/category/${data.category}`} class="tap-area transition-colors hover:text-ink">
            {data.category}
          </a>
        </p>
        <h1 class="mt-3 text-h1 text-ink">{data.title}</h1>
        <p class="mt-4 text-body text-ink-muted">{data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-caption text-ink-muted">
          <time datetime={data.publishedAt.toISOString()}>
            {formatDateCN(data.publishedAt)}
          </time>
          {
            data.updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span>更新于 {formatDate(data.updatedAt)}</span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>约 {readingTime(body)} 分钟</span>

          <!-- 分享：优先系统原生分享（移动端最好用），不支持则降级为复制链接 -->
          <button
            type="button"
            id="share-post"
            data-share-title={data.title}
            class="tap-area ml-1 inline-flex items-center gap-1 text-caption text-ink-muted transition-colors hover:text-ink"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M12 3v12"></path>
              <path d="M7.5 7.5 12 3l4.5 4.5"></path>
              <path d="M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path>
            </svg>
            <span data-share-label>分享</span>
          </button>
        </div>

        {
          data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tags/${tag}`}
                    class="inline-block rounded-pill px-3 py-1.5 text-caption text-ink-muted transition-colors hover:text-ink"
                    style="background-color: var(--surface-alt);"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <!--
          合集条：告诉读者「这是哪条线、第几章」，点进去是整条路线的目录。
          位置放在标签下方——标签是「归类」，合集是「顺序」，后者回答的是
          「下一篇读什么」，所以更靠前、也更显眼。
        -->
        {
          collectionInfo && (
            <a
              href={`/collections/${collectionInfo.entry.collection.id}`}
              class="group mt-6 flex items-center gap-3 rounded-card-sm px-4 py-3"
              style="background-color: var(--surface-alt);"
            >
              <span class="shrink-0 text-caption text-ink-muted">合集</span>
              <span class="min-w-0 flex-1 truncate text-small text-ink transition-colors group-hover:text-accent">
                {collectionInfo.entry.collection.data.title}
              </span>
              <span class="shrink-0 text-caption tabular-nums text-ink-muted">
                第 {collectionInfo.index + 1} / {collectionInfo.entry.chapters.length} 章
              </span>
            </a>
          )
        }
      </div>

      {
        data.cover && (
          <figure
            class="w-full shrink-0 overflow-hidden rounded-card sm:w-[300px]"
            style={`aspect-ratio: ${aspect};`}
          >
            <Image
              src={data.cover}
              alt={`${data.title} 封面`}
              widths={[300, 600]}
              sizes="(max-width: 640px) 100vw, 300px"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )
      }
    </header>

    <!-- 无封面时用一条分隔线代替封面的分隔作用 -->
    {!data.cover && <hr class="mt-12 max-w-[680px] border-line" />}

    <div class="mt-14 flex gap-12">
      <div class="prose-article min-w-0 flex-1" style="max-width: 680px;">
        <Content />
      </div>

      {
        toc.length > 0 && (
          <aside class="hidden w-[200px] shrink-0 lg:block">
            <div class="sticky top-20">
              <Toc headings={toc} />
            </div>
          </aside>
        )
      }
    </div>

    <!--
      关联专辑：文章讲的是哪张（或哪几张）专辑，从这里出去。
      与专辑页的「写过的相关文章」配成双向 —— 只做单向的话，读者看完文章
      没有办法走到专辑，导流就断在半路。

      支持多张：一首歌既有自己的单曲条目，又后来被收进某张专辑时，
      两张都列出来，顺序照 frontmatter 里写的。整行可点（外壳是 <a>），
      热区足够大；无关联时整块不渲染，不留空壳。
    -->
    {
      postAlbums.length > 0 && (
        <section class="mt-16 max-w-[680px] border-t border-line pt-8">
          <p class="text-caption text-ink-muted">相关专辑</p>
          <ul class="mt-4 space-y-4">
            {postAlbums.map((item) => (
              <li>
                <a href={`/albums/${item.id}`} class="group flex items-center gap-4">
                  <Image
                    src={item.data.cover}
                    alt={`${item.data.title} 封面`}
                    widths={[128]}
                    sizes="64px"
                    class="h-16 w-16 shrink-0 rounded-card-sm object-cover"
                    loading="lazy"
                  />
                  <span class="min-w-0">
                    {/* LP 是常态，不显示标记；单曲 / EP / Live / 精选 才标出来 */}
                    <span class="flex min-w-0 items-center gap-1.5">
                      {item.data.type && item.data.type !== 'LP' && (
                        <span class="album-type">{item.data.type}</span>
                      )}
                      <span class="truncate text-body text-ink transition-colors group-hover:text-accent">
                        {item.data.title}
                      </span>
                    </span>
                    <span class="mt-0.5 block text-caption text-ink-muted">
                      {item.data.artist} · {item.data.year}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!--
      本合集：整条路线的目录 + 当前所在位置（「当前」标在行尾），
      并在下方给出上一章 / 下一章 —— 这是「接下来读什么」最直接的答案。
      章节顺序来自各篇文章的 collectionOrder，不是发布时间。
    -->
    {
      collectionInfo && (
        <section class="mt-16 max-w-[680px] border-t border-line pt-8">
          <div class="flex items-baseline justify-between gap-4">
            <p class="text-caption text-ink-muted">
              合集 · 共 {collectionInfo.entry.chapters.length} 章
            </p>
            <a
              href={`/collections/${collectionInfo.entry.collection.id}`}
              class="tap-area text-caption text-accent hover:underline"
            >
              合集目录 →
            </a>
          </div>

          <h2 class="mt-2 text-h3 text-ink">{collectionInfo.entry.collection.data.title}</h2>

          <CollectionChapters
            chapters={collectionInfo.entry.chapters}
            currentId={post.id}
          />

          {(collectionInfo.prev || collectionInfo.next) && (
            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-small">
              {collectionInfo.prev && (
                <a
                  href={`/posts/${collectionInfo.prev.id}`}
                  class="group inline-flex max-w-full items-baseline gap-1.5"
                >
                  <span class="shrink-0 text-ink-muted">← 上一章</span>
                  <span class="truncate text-ink transition-colors group-hover:text-accent">
                    {collectionInfo.prev.data.title}
                  </span>
                </a>
              )}
              {collectionInfo.next && (
                <a
                  href={`/posts/${collectionInfo.next.id}`}
                  class="group inline-flex max-w-full items-baseline gap-1.5"
                >
                  <span class="shrink-0 text-ink-muted">下一章</span>
                  <span class="truncate text-ink transition-colors group-hover:text-accent">
                    {collectionInfo.next.data.title}
                  </span>
                  <span class="shrink-0 text-ink-muted">→</span>
                </a>
              )}
            </div>
          )}
        </section>
      )
    }

    <!--
      相邻文章：接着读的入口，紧贴正文。语义按时间轴——「上一篇」= 更早、「下一篇」= 更新，
      两栏都带日期，避免歧义。构建时算好，零运行时成本。
    -->
    {
      (prev || next) && (
        <nav class="mt-16 max-w-[680px] border-t border-line pt-8" aria-label="相邻文章">
          <div class="grid gap-6 sm:grid-cols-2">
            {prev && (
              <a href={`/posts/${prev.id}`} class="group block">
                <span class="block text-caption text-ink-muted">← 上一篇</span>
                <span class="mt-1 block text-body text-ink transition-colors group-hover:text-accent">
                  {prev.data.title}
                </span>
                <span class="mt-1 block text-caption tabular-nums text-ink-muted">
                  {formatDate(prev.data.publishedAt)}
                </span>
              </a>
            )}
            {next && (
              <a
                href={`/posts/${next.id}`}
                class:list={['group block sm:text-right', !prev && 'sm:col-start-2']}
              >
                <span class="block text-caption text-ink-muted">下一篇 →</span>
                <span class="mt-1 block text-body text-ink transition-colors group-hover:text-accent">
                  {next.data.title}
                </span>
                <span class="mt-1 block text-caption tabular-nums text-ink-muted">
                  {formatDate(next.data.publishedAt)}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-24 max-w-[680px] border-t border-line pt-12">
          <h2 class="text-h3 text-ink">相关文章</h2>
          <ul class="mt-6 space-y-6">
            {related.map((item) => (
              <li>
                <a href={`/posts/${item.id}`} class="group block">
                  <span class="block text-body text-ink transition-colors group-hover:text-accent">
                    {item.data.title}
                  </span>
                  <span class="mt-1 block text-caption text-ink-muted">
                    {formatDate(item.data.publishedAt)} · {item.data.category}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-16 max-w-[680px]">
      <a href="/posts" class="tap-area inline-block text-small text-accent hover:underline"
        >← 返回文章列表</a
      >
    </div>
  </article>

  <!--
    图片查看器：点正文图片即全屏，支持缩放 / 拖动 / 图注 / 前后翻页。
    **放在 </article> 之后**是这个组件的硬约束——它的脚本是内联在 body 里的普通
    script，会就地执行；排在正文之前时，执行那一刻 `.prose-article` 还不存在。
  -->
  <ImageZoom />
</BaseLayout>

<script data-astro-rerun>
  /**
   * 分享按钮 —— 优先用系统原生分享（移动端体验最好）；
   * 不支持时降级为复制链接。桌面 Firefox 等没有 navigator.share，
   * 所以降级分支不是可选项，是必需的。
   */
  (() => {
    const scope = /** @type {any} */ (window);
    if (scope.__shareBound) return;
    scope.__shareBound = true;

    let resetTimer;

    document.addEventListener('click', async (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest('#share-post') : null;
      if (!button) return;

      const title = button.getAttribute('data-share-title') ?? document.title;
      const url = location.href;
      const label = button.querySelector('[data-share-label]');
      const original = label ? label.textContent : '';

      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch (e) {
          /* 用户取消分享，静默 */
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = '已复制';
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            label.textContent = original;
          }, 1600);
        }
      } catch (e) {
        /* 剪贴板不可用（非 HTTPS 或权限被拒），静默 */
      }
    });
  })();
</script>
