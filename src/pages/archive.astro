---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate, getPublishedPosts, groupByYear } from '../lib/content';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<BaseLayout title="归档" description="按时间翻全部文章">
  <PageHeader title="归档" description={`共 ${posts.length} 篇，跨 ${years.length} 个年份。`} />

  <div class="mx-auto max-w-[980px] px-6 pb-24">
    {
      years.length > 0 ? (
        <div class="space-y-16">
          {years.map(([year, items]) => (
            <section data-reveal>
              <div class="flex items-baseline gap-5">
                <h2 class="text-h2 tabular-nums text-ink">{year}</h2>
                <span class="text-caption text-ink-muted">{items.length} 篇</span>
              </div>

              <ul class="mt-6 border-t border-line">
                {items.map((post) => (
                  <li class="border-b border-line">
                    <a
                      href={`/posts/${post.id}`}
                      class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6"
                    >
                      <time
                        datetime={post.data.publishedAt.toISOString()}
                        class="shrink-0 text-caption tabular-nums text-ink-muted sm:w-[92px]"
                      >
                        {formatDate(post.data.publishedAt).slice(5)}
                      </time>
                      <span class="text-body text-ink transition-colors group-hover:text-accent">
                        {post.data.title}
                      </span>
                      <span class="text-caption text-ink-muted sm:ml-auto sm:shrink-0">
                        {post.data.category}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="text-small text-ink-muted">还没有文章。</p>
      )
    }
  </div>
</BaseLayout>
