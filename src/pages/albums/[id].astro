---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import albumColors from '../../data/album-colors.json';
import {
  collectArtists,
  formatDate,
  getPublishedAlbums,
  getPublishedPosts,
  type Album,
} from '../../lib/content';

export async function getStaticPaths() {
  const albums = await getCollection('albums', ({ data }) => !data.draft);
  return albums.map((album) => ({ params: { id: album.id }, props: { album } }));
}

interface Props {
  album: Album;
}

const { album } = Astro.props;
const { data } = album;
const { Content } = await render(album);

/**
 * 封面主色（§7.3.1）：**只在这一页**做一层极淡的径向光晕。
 * 构建时由 `scripts/extract-album-colors.mjs` 提取（prebuild 钩子自动跑），
 * 产物是静态 JSON —— 零运行时依赖。取不到就整块不显示，不留空壳。
 */
const albumColor = (albumColors as Record<string, string>)[album.id] ?? null;

// 反向关联：哪些文章挂在这张专辑上
const posts = await getPublishedPosts();
const linked = posts.filter((post) => post.data.album === album.id);

// 双向导流：这位歌手的其他作品（§7.4）。
// 这条链不通，歌手页与专辑页就只是两个互不相干的列表。
const siblings = (await getPublishedAlbums()).filter(
  (item) => item.data.artist === data.artist && item.id !== album.id
);
// 歌手页的 URL 段要取聚合结果里的 id（有档案时是 ASCII 目录名，不是显示名）
const artistEntry = (await collectArtists()).find((entry) => entry.name === data.artist);
---

<BaseLayout title={`${data.title} — ${data.artist}`} description={`${data.artist}《${data.title}》听后感`}>
  <article
    class="album-page relative mx-auto max-w-[980px] px-6 pb-24 pt-20 md:pt-24"
    style={albumColor ? `--album-color: ${albumColor};` : undefined}
  >
    {/* 极淡的环境色：只是「隐约有色」，不参与信息层级（§7.3.1） */}
    {albumColor && <div class="album-glow" aria-hidden="true" />}

    <div class="flex flex-col gap-10 sm:flex-row sm:gap-12">
      <div class="w-full shrink-0 sm:w-[320px]" data-reveal>
        <!--
          唱片机：点封面让黑胶转起来（§7 一期第 18 项）。
          防溢出约束（v1.15）：sm+ 右下伸出量 36px < 左右栏 gap 48px，不碰文字栏；
          窄屏是 stack 布局，黑胶改为叠在封面**之上**原地旋转——
          向外伸出会超出 px-6 的 24px 内边距，把页面撑出横向溢出。
        -->
        <button
          type="button"
          data-vinyl-toggle
          aria-pressed="false"
          aria-label="让黑胶转起来"
          class="album-turntable relative block w-full cursor-pointer border-0 bg-transparent p-0 text-left"
        >
          <Image
            src={data.cover}
            alt={`${data.title} 封面`}
            widths={[320, 640]}
            sizes="(max-width: 640px) 100vw, 320px"
            class="relative z-10 w-full rounded-card object-cover"
            loading="eager"
          />

          <span class="vinyl" aria-hidden="true">
            <span class="vinyl-disc">
              <Image
                src={data.cover}
                alt=""
                widths={[140]}
                sizes="140px"
                class="vinyl-label"
                loading="lazy"
              />
              <span class="vinyl-hole"></span>
            </span>
          </span>
        </button>

        <p class="mt-3 text-caption text-ink-muted">点一下封面，黑胶转起来</p>
      </div>

      <div class="min-w-0 flex-1">
        <p class="text-caption uppercase tracking-widest text-ink-muted">{data.artist}</p>
        <h1 class="mt-3 text-h1 text-ink">{data.title}</h1>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-small text-ink-muted">
          <span class="tabular-nums">{data.year}</span>
          {
            data.rating !== undefined && (
              <span>
                <span class="font-semibold" style="color: var(--accent);">
                  {data.rating.toFixed(1)}
                </span>
                <span class="text-caption"> / 10</span>
              </span>
            )
          }
          {data.listenedAt && <span>入坑 {formatDate(data.listenedAt)}</span>}
        </div>

        {
          (data.genre.length > 0 || data.mood.length > 0) && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {[...data.genre, ...data.mood].map((label) => (
                <li
                  class="rounded-pill px-3 py-1.5 text-caption text-ink-muted"
                  style="background-color: var(--surface-alt);"
                >
                  {label}
                </li>
              ))}
            </ul>
          )
        }

        {
          data.link && (
            <p class="mt-6">
              <a
                href={data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="tap-area inline-block text-small text-accent hover:underline"
              >
                在网易云音乐收听 →
              </a>
            </p>
          )
        }
      </div>
    </div>

    <hr class="mt-16 border-line" />

    <div class="prose-article mx-auto mt-12" style="max-width: 680px;">
      <Content />
    </div>

    {
      siblings.length > 0 && (
        <section class="mx-auto mt-20 max-w-[680px] border-t border-line pt-10">
          <h2 class="text-h3 text-ink">{data.artist} 的其他作品</h2>
          <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3">
            {siblings.map((item) => (
              <AlbumCard album={item} />
            ))}
          </div>
          {artistEntry && (
            <p class="mt-8">
              <a
                href={`/artists/${artistEntry.id}`}
                class="tap-area inline-block text-small text-accent hover:underline"
              >
                看 {data.artist} 的全部作品 →
              </a>
            </p>
          )}
        </section>
      )
    }

    {
      linked.length > 0 && (
        <section class="mx-auto mt-20 max-w-[680px] border-t border-line pt-10">
          <h2 class="text-h3 text-ink">写过的相关文章</h2>
          <ul class="mt-5 space-y-4">
            {linked.map((post) => (
              <li>
                <a href={`/posts/${post.id}`} class="text-body text-accent hover:underline">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mx-auto mt-16 max-w-[680px]">
      <a href="/albums" class="tap-area inline-block text-small text-accent hover:underline"
        >← 返回专辑墙</a
      >
    </div>
  </article>
</BaseLayout>

<script data-astro-rerun>
  /**
   * 唱片机开关：class 切在按钮上，样式与动效全在下方 <style> 里。
   *
   * ⚠ 视图过渡下这个脚本会随每次导航重新执行，但**不能依赖「重执行」来重新绑事件** ——
   *   脚本执行的时机与 DOM 替换之间存在竞态，实测会出现「首次导航进来点了没反应、
   *   刷新一下就好了」。所以按站内统一做法写：
   *   ① 幂等守卫（window 级引用）② 点击用**事件委托**绑在 document 上 ③ 回调里现查元素。
   *   这样与脚本执行几次无关，任何时刻的点击都能命中。
   */
  const scope = /** @type {any} */ (window);
  if (!scope.__vinylDelegated) {
    scope.__vinylDelegated = true;
    document.addEventListener('click', (e) => {
      const el = e.target;
      const btn = el && el.closest ? el.closest('[data-vinyl-toggle]') : null;
      if (!btn) return;
      const playing = btn.classList.toggle('is-playing');
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute('aria-label', playing ? '把黑胶收回封套' : '让黑胶转起来');
    });
  }
</script>

<style>
  /* 黑胶圆盘：藏在封面正后方，右缘与容器对齐（宽度 92% < 100%，完全被封面盖住） */
  .vinyl {
    position: absolute;
    top: 50%;
    right: 0;
    width: 92%;
    aspect-ratio: 1;
    transform: translate(0, -50%);
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0; /* 低于封面（z-10）：sm+ 只露出右侧月牙 */
    pointer-events: none; /* 点击一律交给外层 button */
  }

  /* sm+：向右下滑出 40px —— 仍小于左右栏 48px 的 gap，不侵入文字栏（v1.15 防溢出约束） */
  .album-turntable.is-playing .vinyl {
    transform: translate(40px, calc(-50% + 40px));
  }

  /* 窄屏（<640px）stack 布局：伸出容器会溢出视口，改为叠在封面之上居中旋转 */
  @media (max-width: 639px) {
    .vinyl {
      z-index: 20;
      right: auto;
      left: 50%;
      width: 78%;
      transform: translate(-50%, -50%);
    }

    .album-turntable.is-playing .vinyl {
      transform: translate(-50%, -50%);
    }
  }

  /*
    纯 CSS 黑胶。
    盘面必须是「非旋转对称」的——同心纹路无论怎么转都看不出，
    而桌面端露出的只有右侧一片月牙（中心标签被封面挡着），
    所以转动可见性全靠 conic 的**四道彗尾亮痕**撑着：亮头 0.22 + 60° 渐隐尾，
    每 90° 一道 —— 每 1/4 圈就有一道扫过月牙，明暗连续流动，肉眼立刻读到「在转」。
    数量与角度是按「窄月牙 + 1.8s/圈」配的：两道太稀疏（像一闪一闪），
    尾再短就成闪光而不是转动。整体压得很淡，只做参照不抢戏。
  */
  .vinyl-disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      conic-gradient(
        from 0deg,
        rgba(255, 255, 255, 0.22) 0deg 3deg,
        rgba(255, 255, 255, 0.06) 3deg 60deg,
        transparent 60deg 90deg,
        rgba(255, 255, 255, 0.22) 90deg 93deg,
        rgba(255, 255, 255, 0.06) 93deg 150deg,
        transparent 150deg 180deg,
        rgba(255, 255, 255, 0.22) 180deg 183deg,
        rgba(255, 255, 255, 0.06) 183deg 240deg,
        transparent 240deg 270deg,
        rgba(255, 255, 255, 0.22) 270deg 273deg,
        rgba(255, 255, 255, 0.06) 273deg 330deg,
        transparent 330deg 360deg
      ),
      repeating-radial-gradient(
        circle at 50% 50%,
        rgba(255, 255, 255, 0.09) 0 1px,
        transparent 1px 3.6px
      ),
      radial-gradient(circle at 50% 50%, #1b1b20 0 34%, #0a0a0c 34% 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .album-turntable.is-playing .vinyl-disc {
    animation: vinyl-spin 1.8s linear infinite;
  }

  @keyframes vinyl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 中心标签：专辑封面缩略图裁成圆 */
  .vinyl-label {
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* 轴孔：透出页面背景色 */
  .vinyl-hole {
    position: absolute;
    width: 5%;
    min-width: 6px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface);
  }

  /* prefers-reduced-motion 由 global.css 的全局规则接管：时长压到 0.01ms，
     黑胶不会持续旋转，只会瞬间到达目标状态 */

  /*
    专辑主色光晕（§7.3.1）。
    `isolation: isolate` 把 z-index:-1 关在 article 内部——否则它会跑到 body
    背景后面，整块看不见。高度固定：渐变若按元素高度摊开（这一页很长），
    会散得没有形状。不透明度压得很低，它只是环境色，不参与信息层级。
  */
  .album-page {
    isolation: isolate;
  }

  .album-glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 780px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      72% 56% at 28% 18%,
      color-mix(in srgb, var(--album-color) 34%, transparent),
      transparent 100%
    );
    /*
      ⚠ 两步必需的 mask。
      径向渐变是个**椭圆**，它在到达元素左边缘与上边缘时还有颜色，于是被硬裁 ——
      表现为一条从页眉直下的竖线 + 一条横线（2026-10-10 令宸反馈「左侧突然一根线截断」）。
      渐变参数调不出「范围大」与「边缘不裁」兼得（要么缩到很小、要么出界被裁），
      所以让边缘自己渐隐：两个 linear-gradient 取交集，左与上都淡出。
    */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 20%),
      linear-gradient(to bottom, transparent 0%, #000 16%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 20%),
      linear-gradient(to bottom, transparent 0%, #000 16%);
    mask-composite: intersect;
  }

  /* 同样的透明度在深底上会看不出来，深色主题单独提一档 */
  :global(html.dark) .album-glow {
    background: radial-gradient(
      72% 56% at 28% 18%,
      color-mix(in srgb, var(--album-color) 46%, transparent),
      transparent 100%
    );
  }
</style>
